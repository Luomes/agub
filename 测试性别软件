<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>国家级测试父母性别器</title>
<style>
  body {
    margin: 0;
    padding: 0;
    background: #0b0b1f;
    color: white;
    font-family: Arial, sans-serif;
  }
  .page {
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: absolute;
    visibility: hidden;
  }
  .btn {
    margin: 15px;
    padding: 15px 30px;
    font-size: 20px;
    border-radius: 10px;
    border: none;
    background: #2d7ff9;
    color: white;
    cursor: pointer;
  }
  .exit-btn {
    background: #ff4444;
  }
  .title {
    font-size: 32px;
    color: #ffcc00;
    margin-bottom: 30px;
    text-align: center;
  }
  .quantum {
    font-size: 24px;
    color: #00eaff;
    margin-bottom: 20px;
  }
  .result-text {
    font-size: 28px;
    color: #ffcc00;
  }
</style>
</head>
<body>

<!-- 主封面 -->
<div class="page" id="home" style="visibility:visible;">
  <div class="title">国家级测试父母性别器</div>
  <button class="btn" onclick="startTest()">1. 测试性别</button>
  <button class="btn exit-btn" onclick="exitTest()">2. 不测试退出</button>
</div>

<!-- 第1题：父母性别 -->
<div class="page" id="p1">
  <h2>你父母的性别</h2>
  <button class="btn" onclick="chooseParent(1)">1. 男</button>
  <button class="btn" onclick="chooseParent(2)">2. 女</button>
</div>

<!-- 第2题：早饭 -->
<div class="page" id="p2">
  <h2>是否吃过早饭</h2>
  <button class="btn" onclick="next(3)">1. 吃了</button>
  <button class="btn" onclick="next(3)">2. 没有</button>
</div>

<!-- 第3题：午饭 -->
<div class="page" id="p3">
  <h2>是否吃过午饭</h2>
  <button class="btn" onclick="next(4)">1. 吃了</button>
  <button class="btn" onclick="next(4)">2. 没有</button>
</div>

<!-- 第4题：晚饭 -->
<div class="page" id="p4">
  <h2>是否吃过晚饭</h2>
  <button class="btn" onclick="quantumResult()">1. 吃了</button>
  <button class="btn" onclick="quantumResult()">2. 没有</button>
</div>

<!-- 量子计算页面 -->
<div class="page" id="quantumPage">
  <div class="quantum">正在量子计算父母性别中...</div>
  <div id="finalResult" class="result-text"></div>
</div>

<script>
  let parentGender = 0;

  // 开始测试
  function startTest() {
    showPage('p1');
  }

  // 退出：弹窗2秒后关闭网页
  function exitTest() {
    alert("不测性别点干啥😡😡😡");
    setTimeout(() => {
      window.close();
    }, 2000);
  }

  // 选择性别
  function chooseParent(g) {
    parentGender = g;
    next(2);
  }

  // 下一页
  function next(n) {
    showPage('p' + n);
  }

  // 显示指定页面
  function showPage(id) {
    document.querySelectorAll('.page').forEach(p => p.style.visibility = 'hidden');
    document.getElementById(id).style.visibility = 'visible';
  }

  // 量子计算结果
  function quantumResult() {
    showPage('quantumPage');
    setTimeout(() => {
      let res = parentGender === 1 ? "男" : "女";
      document.getElementById('finalResult').innerText = "量子计算完成：父母性别为 " + res;
    }, 1500);
  }
</script>
</body>
</html>
